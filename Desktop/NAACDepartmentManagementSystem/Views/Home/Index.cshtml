@{
    ViewData["Title"] = "Home";
}
<div class="container-fluid hero-section">
    <div class="row align-items-center">

        <!-- LEFT CONTENT -->
        <div class="col-md-6 hero-text">
            <h1 class="fw-bold">
                NAAC Criteria V & <br />
                VI Based <br />
                Management System
            </h1>

            <p class="mt-3">
                Centralized web platform to manage NAAC data.
            </p>

            <div class="mt-4">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary me-3">Login</a>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary">Registration</a>
            </div>
        </div>

        <!-- RIGHT IMAGE -->
        <div class="col-md-6 hero-image text-center">
    <div class="image-glow">
        <img src="~/images/landing.png"
             class="img-fluid hero-img"
             alt="NAAC Illustration" />
    </div>
</div>


    </div>
</div>
